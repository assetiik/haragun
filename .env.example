APP_NAME=Haragun
API_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Leave empty to send a random OTP via Mobizon. Set a 4-digit code for local/testing without SMS.
OTP_STATIC_CODE=
OTP_SMS_MESSAGE="Ваш код для входа в Haragun: {code}"

# Mobizon SMS gateway (https://api.mobizon.kz). Leave API key empty to only log OTP codes.
MOBIZON_API_KEY=
MOBIZON_BASE_URL=https://api.mobizon.kz
MOBIZON_FROM=Haragun

# Ticket provider for ice arena: dss_soft or rink_api (Muzpass).
TICKET_PROVIDER=rink_api

# DSS-Soft partner API for ice-rink tickets and turnstile QR codes.
# Leave the token empty to keep local fake slots. Do not commit the PEM.
DSS_SOFT_BASE_URL=https://api.dss-soft.kz
DSS_SOFT_PARTNER_TOKEN=
DSS_SOFT_PUBLIC_KEY_PATH=
DSS_SOFT_SHOW_ID=195

# Muzpass rink ticket API. Keep the key on the server only — never ship it in the mobile app.
# Production: https://api.muzpass.com/api/v1
# Test (docs / Try it out): https://178-62-199-193.sslip.io/api/v1
# Use the matching API key for the chosen base URL (test key ≠ production key).
RINK_API_BASE_URL=https://api.muzpass.com/api/v1
RINK_API_KEY=
RINK_API_SALE_KIND=online

# TipTop Pay (https://developers.tiptoppay.kz). Keep API secrets on the server only.
# Separate merchants for ice arena and standalone coffee shops.
# Shared TIPTOP_PAY_PUBLIC_ID / API_SECRET are fallbacks when ICE_/COFFEE_ keys are empty.
# When disabled/empty for a venue type, that type stays mock-paid.
TIPTOP_PAY_ENABLED=false
TIPTOP_PAY_BASE_URL=https://api.tiptoppay.kz
TIPTOP_PAY_PUBLIC_ID=
TIPTOP_PAY_API_SECRET=
TIPTOP_PAY_ICE_PUBLIC_ID=
TIPTOP_PAY_ICE_API_SECRET=
TIPTOP_PAY_COFFEE_PUBLIC_ID=
TIPTOP_PAY_COFFEE_API_SECRET=
# Online fiscal receipt (Kassir). Leave VAT empty = not subject to VAT. Rates: 0, 5, 10, 12, 16.
TIPTOP_PAY_RECEIPT_VAT=
# Optional taxation system: 0=general, 1=simplified, 4=patent. Empty = cash register default.
TIPTOP_PAY_RECEIPT_TAXATION_SYSTEM=

# iiko Cloud API for coffee POS orders. Leave api login empty to keep local-only coffee orders.
# Per cafe: set organization / terminal group / table / payment type ids on the establishment.
# Per drink: set iiko_product_id on the product.
IIKO_BASE_URL=https://api-ru.iiko.services
IIKO_API_LOGIN=

# Firebase Cloud Messaging. Leave empty until the service account JSON is in place.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

HARAGUN_ABOUT_TEXT="Haragun — приложение для заказа кофе, еды и билетов на ледовую арену. Оформляйте заказы заранее и забирайте их без очереди."
HARAGUN_SUPPORT_PHONE="+7 700 000 00 00"
HARAGUN_SUPPORT_PHONE_RAW=77000000000
HARAGUN_SUPPORT_EMAIL=support@haragun.kz
HARAGUN_SUPPORT_ADDRESS=Алматы
HARAGUN_SUPPORT_HOURS="Ежедневно 09:00–22:00"
